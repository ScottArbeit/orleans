<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Microsoft.Orleans.Persistence.Cosmos</PackageId>
    <Title>Microsoft Orleans Grain Storage for Azure Cosmos DB</Title>
    <Description>Microsoft Orleans persistence providers for Azure Cosmos DB</Description>
    <PackageTags>$(PackageTags) Azure Cosmos DB Storage</PackageTags>
    <TargetFrameworks>$(DefaultTargetFrameworks)</TargetFrameworks>
    <AssemblyName>Orleans.Persistence.Cosmos</AssemblyName>
    <RootNamespace>Orleans.Persistence.Cosmos</RootNamespace>
    <OrleansBuildTimeCodeGen Condition="'$(CosmosRuntimePackageVersion)' == ''">true</OrleansBuildTimeCodeGen>
    <OrleansBuildTimeCodeGen Condition="'$(CosmosRuntimePackageVersion)' != ''">false</OrleansBuildTimeCodeGen>
    <DefineConstants>$(DefineConstants);ORLEANS_PERSISTENCE</DefineConstants>
    <Nullable>enable</Nullable>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Shared\Cosmos\CosmosOptions.cs" Link="Storage\CosmosOptions.cs" />
    <Compile Include="..\Shared\Cosmos\CosmosOptionsValidator.cs" Link="Storage\CosmosOptionsValidator.cs" />
    <Compile Include="..\Shared\Cosmos\BaseEntity.cs" Link="Storage\BaseEntity.cs" />
    <Compile Include="..\Shared\Cosmos\Usings.cs" Link="Storage\Usings.cs" />
    <Compile Include="..\Shared\Cosmos\CosmosIdSanitizer.cs" Link="Storage\CosmosIdSanitizer.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(SourceRoot)src\Orleans.Runtime\Orleans.Runtime.csproj"
                      Condition="'$(CosmosRuntimePackageVersion)' == ''" />
    <!-- Build release-line provider packages against the exact public Orleans package set they extend. -->
    <PackageReference Include="Microsoft.Orleans.Analyzers"
                      VersionOverride="$(CosmosRuntimePackageVersion)"
                      PrivateAssets="None"
                      Condition="'$(CosmosRuntimePackageVersion)' != ''" />
    <PackageReference Include="Microsoft.Orleans.CodeGenerator"
                      VersionOverride="$(CosmosRuntimePackageVersion)"
                      PrivateAssets="None"
                      Condition="'$(CosmosRuntimePackageVersion)' != ''" />
    <PackageReference Include="Microsoft.Orleans.Runtime"
                      VersionOverride="$(CosmosRuntimePackageVersion)"
                      Condition="'$(CosmosRuntimePackageVersion)' != ''" />
    <PackageReference Include="Azure.Core" />
    <PackageReference Include="Microsoft.Azure.Cosmos" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Orleans.Cosmos.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
